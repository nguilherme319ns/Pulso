{
  "name": "api-conta-digital",
  "version": "1.1.0",
  "description": "API REST de conta digital com transferências estilo Pix (projeto de estudo, dados fictícios)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "env:init": "node scripts/init-env.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:setup:test": "node scripts/setup-db.js conta_digital_test",
    "test": "node scripts/test.js",
    "test:unit": "node --test tests/validation.test.js tests/transaction.test.js",
    "test:integration": "node scripts/test.js --integration",
    "demo": "node scripts/demo.js",
    "reconcile": "node scripts/reconcile.js"
  },
  "keywords": ["nodejs", "express", "mysql", "rest-api", "fintech", "pix", "jwt", "ledger"],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
