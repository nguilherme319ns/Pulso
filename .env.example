# Gere valores locais com: npm run env:init
# Nunca publique o arquivo .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=conta_app
DB_PASSWORD=__GENERATE_DB_PASSWORD__
DB_NAME=conta_digital
DB_POOL_SIZE=10
TEST_DB_NAME=conta_digital_test
JWT_SECRET=__GENERATE_JWT_SECRET__
JWT_EXPIRES_IN=1h
# Usada somente pelo MySQL do Docker Compose.
MYSQL_ROOT_PASSWORD=__GENERATE_ROOT_PASSWORD__
